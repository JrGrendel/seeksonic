# Copy this file to .env and replace the secret values.
# Generate strong secrets with: openssl rand -hex 32

# Navidrome URL reachable FROM the proxy container.
# Use the hostname or IP address reachable from this container.
NAVIDROME_URL=http://navidrome:4533
NAVIDROME_USER=lyrics-indexer
NAVIDROME_PASSWORD=your-strong-password

# Use the SAME Meilisearch master key for both services.
MEILI_MASTER_KEY=

# Management UI credentials. Generate the session secret with: openssl rand -hex 32
ADMIN_USER=admin
ADMIN_PASSWORD=your-strong-admin-password
ADMIN_SESSION_SECRET=
# Set true when the dashboard is accessed through an HTTPS reverse proxy.
SESSION_COOKIE_SECURE=false

# Proxy listener. 127.0.0.1 is suitable when a host-level reverse proxy
# (for example Caddy) connects to this service. Use 0.0.0.0 for LAN clients.
PROXY_BIND=127.0.0.1
PROXY_PORT=8788

SYNC_INTERVAL_MINUTES=30
SYNC_WORKERS=4
LYRIC_MATCH_LIMIT=5
WAITRESS_THREADS=8
MEILI_TASK_TIMEOUT=120
LOG_LEVEL=INFO

# Meilisearch anonymous telemetry. Disabled by default; set false to opt in.
MEILI_NO_ANALYTICS=true
